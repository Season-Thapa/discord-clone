@using Pin.Discord.Core.Interfaces
@using Pin.Discord.Blazor.State
﻿@using Pin.Discord.Core.Entities


@inject UserState UserState
@inject IServerService ServerService
@inject NavigationManager NavManager
@inject ServerState ServerState

<div class="d-flex flex-column align-items-center p-2" style="width: 80px; background-color: #202225; height: 100vh;">
    @if (UserState.IsLoggedIn)
    {
        <!-- Sidebar -->
        <button class="btn btn-primary rounded-circle mb-3" style="width: 48px; height: 48px; font-size: 28px;" @onclick="NavigateToDiscover">+</button>
        <button class="btn btn-primary rounded-circle mb-3" style="width: 48px; height: 48px; font-size: 28px;" @onclick="AvailableUsers">M</button>

        @if (ServerState.Servers == null)
        {
            <p class="text-muted small text-center">Loading...</p>
        }
        else
        {
            @foreach (var server in ServerState.Servers)
            {
                <div class="d-flex justify-content-center align-items-center bg-secondary text-white rounded-circle mb-3"
                     title="@server.ServerName"
                     @onclick="() => NavigateToServer(server.Id)"
                     style="width: 48px; height: 48px; cursor: pointer; font-weight: 700; font-size: 16px;">
                    @server.ServerName.Substring(0, 1).ToUpper()
                </div>
            }
        }

    }
    else
    {
        <div class="p-3 bg-dark">
            <NavLink href="/login" class="text-primary text-decoration-none">Login</NavLink>
        </div>
        <div class="p-3 bg-dark">
            <NavLink href="/register" class="text-primary text-decoration-none">Register</NavLink>
        </div>
    }
</div>




@code {
    [Parameter]
    public int CurrentUserId { get; set; }
    protected override async Task OnParametersSetAsync()
    {
        if (CurrentUserId > 0)
        {

            if (ServerState.Servers == null || ServerState.Servers.Count == 0)
            {
                ServerState.Servers = (await ServerService.GetServersForUserAsync(CurrentUserId)).ToList();
            }
            ServerState.OnChange += StateHasChanged;

        }
    }
    private void NavigateToServer(int serverId)
    {
        NavManager.NavigateTo($"/user/{CurrentUserId}/servers/{serverId}");
    }

    private void NavigateToDiscover()
    {
        NavManager.NavigateTo($"/user/{CurrentUserId}/availableServers");
    }
    private void AvailableUsers()
    {
        NavManager.NavigateTo($"/users/chat/{CurrentUserId}");

    }
    public void Dispose()
    {
        ServerState.OnChange -= StateHasChanged;
    }
}
