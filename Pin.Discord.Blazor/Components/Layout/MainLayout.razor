@inherits LayoutComponentBase

<div class="page d-flex" style="height: 100vh; background-color: #202225;">
    <div class="sidebar" style="width: 80px; background-color: #202225;">
        <NavMenu />
    </div>

    <main class="flex-grow-1" style="background-color: #2F3136; color: white; overflow-y: auto;">
        <div class="top-row px-4" style="padding: 1rem; background-color: #2F3136;">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank" style="color: white;">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>