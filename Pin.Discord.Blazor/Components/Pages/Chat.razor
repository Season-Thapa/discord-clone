@using Microsoft.AspNetCore.SignalR.Client
@using Pin.Discord.Core.Entities
@using Pin.Discord.Core.Interfaces
@page "/chathub"
@inject NavigationManager Navigation
@inject IMessageService messageService

<h3>@CurrentChannelName</h3>

<ul>
    @foreach (var message in ChatMessages)
    {
        <li><b>@message.UserName</b>: @message.Content</li>
    }
</ul>

<input @bind="NewMessage" @onkeydown="HandleKey" />

@code {
    private HubConnection _hub;
    private List<ChatMessageDto> ChatMessages = new();
    private string NewMessage;
    private int ChannelId;
    private string CurrentChannelName;

    protected override async Task OnInitializedAsync()
    {
        _hub = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/chathub"))
            .WithAutomaticReconnect()
            .Build();

        _hub.On<int, string, string>("ReceiveMessage", (channelId, userName, message) =>
        {
            ChatMessages.Add(new ChatMessageDto { ChannelId = channelId, UserName = userName, Content = message });
            StateHasChanged();
        });

        await _hub.StartAsync();
        await _hub.InvokeAsync("JoinChannel", ChannelId);
    }

    private async Task HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(NewMessage))
        {
            await _hub.InvokeAsync("SendMessage", ChannelId, "CurrentUser", NewMessage);
            NewMessage = "";
        }
    }

    public class ChatMessageDto
    {
        public int ChannelId { get; set; }
        public string UserName { get; set; }
        public string Content { get; set; }
    }
}
