@page "/login"
@using Pin.Discord.Core.Interfaces
@using Pin.Discord.Core.Services.State;


@inject IUserService UserService
@inject NavigationManager Navigation
@inject UserState UserState

<h3>Login</h3>


@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <p style="color:red">e</p>
}

<input @bind="Username" placeholder="Username" />
<br />
<input @bind="Password" type="password" placeholder="Password" />
<br />
<button @onclick="LoginAsync">Login</button>


@code {
    private string Username;
    private string Password;
    private string ErrorMessage;

    private async Task LoginAsync()
    {
        var user = await UserService.AuthenticateAsync(Username, Password);

        if (user != null)
        {
            UserState.CurrentUserId = user.Id;
            Navigation.NavigateTo($"/");
        }
        else
        {
            ErrorMessage = "Invalid credentials";
        }
    }

}