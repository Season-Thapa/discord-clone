@page "/message/currentuser/{CurrentUserId:int}/selecteduser/{SelectedUserId:int}"
@using Pin.Discord.Core.Entities
@using Pin.Discord.Core.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.SignalR.Client
@using Pin.Discord.Blazor.Models

@inject IUserService UserService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@implements IAsyncDisposable

<h3>@SelectedUser?.Name</h3>

<div class="messages-container">
    @if (!ChatMessages.Any())
    {
        <p>No messages yet, start chatting!</p>
    }  
    else
    {
        @foreach (var msg in ChatMessages)
        {
            <div class="message">
                <strong>@msg.UserName:</strong> @msg.MessageContent
            </div>
        }
    }
</div>

@if (IsAuthenticated)
{
    <input @bind="newMessage" placeholder="Type your message..." @onkeydown="HandleEnterKey" />
    <button @onclick="Send" disabled="@(!IsConnected)">Send</button>
}
else
{
    <p><em>Loading...</em></p>
}

@code {
    [Parameter]
    public int SelectedUserId { get; set; }
    [Parameter]
    public int CurrentUserId { get; set; }

    private User SelectedUser { get; set; }
    private List<ChatMessage> ChatMessages = new();
    private string newMessage;
    private bool IsAuthenticated;
    private HubConnection hubConnection;

    public bool IsConnected => hubConnection?.State == HubConnectionState.Connected;

    protected override async Task OnInitializedAsync()
    {
        SelectedUser = await UserService.GetByIdAsync(SelectedUserId);
        // Setup SignalR hub
        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/chathub"))
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<string, string>("ReceiveMessage", (userName, message) =>
        {
            ChatMessages.Add(new ChatMessage
            {
                UserName = userName,
                MessageContent = message
            });
            InvokeAsync(StateHasChanged);
        });

        await hubConnection.StartAsync();
    }

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(newMessage)) return;

        var currentUser = await UserService.GetByIdAsync(CurrentUserId);
        await hubConnection.SendAsync("SendMessage", currentUser.Name, newMessage);

        newMessage = string.Empty;
    }

    private async Task HandleEnterKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Send();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
