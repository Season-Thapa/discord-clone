@page "/availableServers"
@using Pin.Discord.Core.Entities
@using Pin.Discord.Core.Interfaces
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

@inject IServerService ServerService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager NavManager

<div class="discord-layout" style="display: flex; height: 100vh;">
    <!-- Sidebar -->
    <div class="server-sidebar" style="width: 80px; background-color: #202225; display: flex; flex-direction: column; align-items: center; padding: 10px;">
        <button class="discover-button" @onclick="NavigateToDiscover"
                style="width: 48px; height: 48px; border-radius: 24px; border: none; background-color: #5865F2; color: white; font-size: 24px; cursor: pointer; margin-bottom: 16px;">
            +
        </button>

        @if (ServersList == null)
        {
            <p style="color: gray; text-align: center;">Loading...</p>
        }
        else
        {
            @foreach (var server in ServersList)
            {
                <div class="server-icon"
                     title="@server.ServerName"
                     @onclick="() => NavigateToServer(server.Id)"
                     style="width: 48px; height: 48px; border-radius: 24px; background-color: #36393F; color: white; display: flex; align-items: center; justify-content: center; margin-bottom: 10px; cursor: pointer; font-weight: bold;">
                    @server.ServerName
                </div>
            }
        }
    </div>

    <!-- Main Content -->
    <div class="server-content" style="flex-grow: 1; background-color: #2F3136; color: white; padding: 20px; overflow-y: auto;">
        <h3>Discover Servers</h3>

        @if (availableServers == null)
        {
            <p>Loading...</p>
        }
        else if (!availableServers.Any())
        {
            <p>You have joined all available servers.</p>
        }
        else
        {
            <ul>
                @foreach (var server in availableServers)
                {
                    <li>
                        @server.ServerName
                        <button @onclick="() => JoinServer(server.Id)">Join</button>
                    </li>
                }
            </ul>
        }

        <hr />

        <h3>Create Your Own Server</h3>
        <input type="text" placeholder="Enter server name" @bind="newServerName" />
        <button @onclick="CreateServer">Create</button>
    </div>
</div>

@code {
    private List<Server> ServersList;
    private List<Server> availableServers;
    private int currentUserId;
    private string newServerName;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated ?? false)
        {
            currentUserId = int.Parse(user.FindFirst(ClaimTypes.NameIdentifier)!.Value);

            ServersList = (await ServerService.GetServersForUserAsync(currentUserId)).ToList();
            await LoadAvailableServers();
        }
        else
        {
            NavManager.NavigateTo("/login");
        }
    }

    private async Task LoadAvailableServers()
    {
        availableServers = (await ServerService.GetServersUserNotInAsync(currentUserId)).ToList();
    }

    private async Task JoinServer(int serverId)
    {
        await ServerService.JoinServerAsync(serverId, currentUserId);
        await LoadAvailableServers();
        ServersList = (await ServerService.GetServersForUserAsync(currentUserId)).ToList(); 
    }

    private async Task CreateServer()
    {
        if (!string.IsNullOrWhiteSpace(newServerName))
        {
            await ServerService.AddNewServerAsync(newServerName,currentUserId);
            NavManager.NavigateTo("/servers"); 
        }
    }

    private void NavigateToServer(int serverId)
    {
        NavManager.NavigateTo($"/servers/{serverId}/channels");
    }

    private void NavigateToDiscover()
    {
        NavManager.NavigateTo("/availableServers");
    }
}
