@*@page "/channels/{ChannelId:int}"
@using Pin.Discord.Core.Entities
@using Pin.Discord.Core.Interfaces
@using Microsoft.AspNetCore.SignalR.Client
@using Pin.Discord.Blazor.Models

@inject IChannelService ChannelService
@inject IUserService UserService
@inject NavigationManager Navigation

<h3>@CurrentChannel?.ChannelName</h3>

<div class="messages-container">
    @if (Messages == null)
    {
        <p>Start converstation</p>
    }
    else
    {
        @foreach (var msg in Messages)
        {
            <div class="message">
                <strong>@msg.UserName:</strong> @msg.MessageContent
            </div>
        }
    }
</div>

@if (IsAuthenticated)
{
    <input @bind="NewMessage" placeholder="Type your message..." @onkeydown="HandleKeyPress" />
    <button @onclick="SendMessage">Send</button>
}
else
{
    <p><em>Please wait for hub ready</em></p>
}

@code {
    [Parameter]
    public int ChannelId { get; set; }
    private Channel CurrentChannel;
    private List<ChatMessage> Messages = new();
    private string NewMessage;
    private bool IsAuthenticated;
    private int CurrentUserId;
    private HubConnection hubConnection;

    protected override async Task OnParametersSetAsync()
    {


        IsAuthenticated = user.Identity.IsAuthenticated;
        if (IsAuthenticated)
        {
            CurrentUserId = int.Parse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier).Value);
        }

        CurrentChannel = await ChannelService.GetChannelByChannelId(ChannelId);

        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/chathub"))
            .Build();

        hubConnection.On<ChatMessage>("ReceiveGroupMessage", (message) =>
        {

            Messages.Add(message);
            InvokeAsync(StateHasChanged);

        });

        try
        {
            await hubConnection.StartAsync();
            Console.WriteLine("Hub started");
            await hubConnection.SendAsync("AddToGroup", ChannelId.ToString());
            Console.WriteLine("Added to group: " + ChannelId);
        }
        catch (Exception ex)
        {
            Console.WriteLine("Hub error: " + ex);
        }
    }

    private async Task SendMessage()
    {
        await hubConnection.SendAsync("AddToGroup", ChannelId.ToString());

        if (!string.IsNullOrWhiteSpace(NewMessage))
        {
            var user = await UserService.GetByIdAsync(CurrentUserId);
            var message = new ChatMessage
            {
                UserName = user.Name,
                MessageContent = NewMessage,
                ChannelId = ChannelId.ToString()
            };

            try
            {
                await hubConnection.SendAsync("SendMessageToGroup", ChannelId.ToString(), message);
            }
            catch (Exception ex)
            {
                Console.WriteLine("SendAsync failed: " + ex.Message);
            }
            NewMessage = string.Empty;
            StateHasChanged();
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessage();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}*@
