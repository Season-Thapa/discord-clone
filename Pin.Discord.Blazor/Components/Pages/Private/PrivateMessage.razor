@page "/users/chat/{CurrentUserId:int}"
@using Pin.Discord.Core.Entities
@using Pin.Discord.Core.Interfaces
@using Microsoft.AspNetCore.SignalR.Client
@using Pin.Discord.Blazor.Models

@inject IUserService UserService
@inject IMessageService MessageService
@inject NavigationManager Navigation
@implements IAsyncDisposable

<div style="display: flex; height: 100vh;">
    <!-- Sidebar: List of Users -->
    <div style="width: 240px; background-color: #2F3136; color: white; display: flex; flex-direction: column;">
        <h4 style="padding: 10px;">Message User</h4>
        @if (availableUsers == null)
        {
            <p style="padding: 10px;">No users</p>
        }
        else
        {
            @foreach (var user in availableUsers)
            {
                <div @onclick="() => SelectUser(user)"
                     style="padding: 8px 12px; cursor: pointer; color: @(user == selectedUser ? "white" : "#b9bbbe")">
                    @user.Name
                </div>
            }
        }
    </div>

    <!-- Chat Panel -->
    <div style="flex-grow: 1; background-color: #36393F; color: white; padding: 20px;">
        @if (selectedUser != null)
        {
            <h3>@selectedUser.Name</h3>

            <div class="messages-container" style="max-height: calc(100vh - 150px); overflow-y: auto;">
                @if (!messagesByUser[selectedUser.Id].Any())
                {
                    <p>No messages yet, start chatting!</p>
                }
                else
                {
                    @foreach (var msg in messagesByUser[selectedUser.Id])
                    {
                        <div class="message-container" style="position: relative; margin-bottom: 12px; padding: 10px 12px; background-color: #40444B; border-radius: 8px; max-width: 70%;">

                            <span>
                                <strong>@msg.Username:</strong> @msg.Message
                            </span>

                            <div class="reactions" style="position: absolute; top: 4px; right: 4px; display: flex; gap: 4px; align-items: center;">
                                @foreach (var reaction in msg.Reactions)
                                {
                                    <span style="background-color:#5865F2; color:white; padding:2px 6px; border-radius:12px; font-size:0.8em;">
                                        @reaction.Key (@reaction.Value.Count)
                                    </span>
                                }

                                <button @onclick='() => AddReaction(msg, "👍")'>👍</button>
                                <button @onclick='() => AddReaction(msg, "❤️")'>❤️</button>

                                @if (msg.SenderId != CurrentUserId)
                                {
                                    @if (!msg.IsReported)
                                    {
                                        <button @onclick="() => ReportMessage(msg)"
                                                style="font-size:0.7em; background:none; border:none; cursor:pointer; color:#FF5555;">
                                            Report
                                        </button>
                                    }
                                    else
                                    {
                                        <span style="font-size:0.7em; color:red;">Reported</span>
                                    }
                                }
                            </div>
                        </div>
                    }
                }
            </div>

            <div style="margin-top: 10px;">
                <input @bind="newMessage" placeholder="Type your message..."
                       style="flex: 1; padding: 8px; border-radius: 4px; border: none;" />
                <button @onclick="Send">Send</button>
            </div>
        }
        else
        {
            <p>Select a user to start chatting.</p>
        }
    </div>

</div>

@code {
    [Parameter]
    public int CurrentUserId { get; set; }
    private Dictionary<int, List<ChatMessage>> messagesByUser = new();
    private List<User> availableUsers;
    private User selectedUser;
    private List<ChatMessage> chatMessages = new();
    private HubConnection hubConnection;
    private string newMessage;

    protected override async Task OnInitializedAsync()
    {
        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri($"/chathub?userId={CurrentUserId}"))
            .Build();

        hubConnection.On<Guid, string, string>("ReceiveMessage", async (messageId, userId, message) =>
        {
            var sender = await UserService.GetByIdAsync(int.Parse(userId));
            if (!messagesByUser.ContainsKey(sender.Id))
                messagesByUser[sender.Id] = new List<ChatMessage>();

            messagesByUser[sender.Id].Add(new ChatMessage
            {
                Id = messageId,
                SenderId = sender.Id,
                Username = sender.Name,
                Message = message
            });

            await InvokeAsync(StateHasChanged);
        });
        hubConnection.On<Guid, int, string>("ReceiveReaction",async (messageId, userId, emoji) =>
        {
            foreach (var message in messagesByUser)
            {
                var msg = message.Value.FirstOrDefault(m => m.Id == messageId);
                if (msg != null)
                {
                    if (!msg.Reactions.ContainsKey(emoji))
                        msg.Reactions[emoji] = new List<int>();

                    if (!msg.Reactions[emoji].Contains(userId))
                        msg.Reactions[emoji].Add(userId);

                    await InvokeAsync(StateHasChanged);
                    break;
                }
            }      
    });

        await hubConnection.StartAsync();
    }
    protected override async Task OnParametersSetAsync()
    {
        availableUsers = (await UserService.GetOtherUsersAsync(CurrentUserId)).ToList();
        selectedUser = null;
        chatMessages.Clear();
    }
    private async Task SelectUser(User user)
    {
        selectedUser = user;

        if (!messagesByUser.ContainsKey(user.Id))
            messagesByUser[user.Id] = new List<ChatMessage>();
    }

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(newMessage) || selectedUser == null) return;

        if (!messagesByUser.ContainsKey(selectedUser.Id))
            messagesByUser[selectedUser.Id] = new List<ChatMessage>();

        var msg = new ChatMessage
        {
            Id = Guid.NewGuid(),
            SenderId = CurrentUserId,
            Username = "You",
            Message = newMessage
        };
        messagesByUser[selectedUser.Id].Add(msg);
        await hubConnection.SendAsync("SendMessage", selectedUser.Id, CurrentUserId, msg.Id, newMessage);
        newMessage = string.Empty;
        await InvokeAsync(StateHasChanged);

    }
    private async Task ReportMessage(ChatMessage msg)
    {
        if (selectedUser == null || msg == null) return;
        msg.IsReported = true;
        await MessageService.ReportMessageAsync(CurrentUserId, selectedUser.Id, msg.Message);
        await InvokeAsync(StateHasChanged);
    }
    private async Task AddReaction(ChatMessage msg, string emoji)
    {
        if (!msg.Reactions.ContainsKey(emoji))
            msg.Reactions[emoji] = new List<int>();

        if (!msg.Reactions[emoji].Contains(CurrentUserId))
            msg.Reactions[emoji].Add(CurrentUserId);

        await hubConnection.SendAsync("AddReaction", msg.Id, CurrentUserId, emoji, selectedUser.Id);
        await InvokeAsync(StateHasChanged);
    }
    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
