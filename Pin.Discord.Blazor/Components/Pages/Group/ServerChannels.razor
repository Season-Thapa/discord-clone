@page "/user/{CurrentUserId:int}/servers/{ServerId:int}"

@using Pin.Discord.Core.Entities
@using Pin.Discord.Core.Interfaces
@using Microsoft.AspNetCore.SignalR.Client
@using Pin.Discord.Blazor.Models
@inject IChannelService ChannelService
@inject IUserService UserService
@inject NavigationManager Navigation

<div style="display: flex; height: 100vh;">
    <!-- Channel Sidebar -->
    <div style="width: 240px; background-color: #2F3136; color: white; display: flex; flex-direction: column;">
        <h4 style="padding: 10px;">Channels</h4>
        @if (Channels == null)
        {
            <p style="padding: 10px;">Loading...</p>
        }
        else
        {
            @foreach (var channel in Channels)
            {
                <div @onclick="() => SelectChannel(channel)"
                     style="padding: 8px 12px; cursor: pointer; color: @(SelectedChannel?.Id == channel.Id ? "white" : "#b9bbbe")">
                    # @channel.ChannelName
                </div>
            }
        }
        <div style="padding: 10px;">
            <input @bind="NewChannelName" placeholder="New channel name" style="width: 100%;" />
            <button @onclick="AddChannelAsync" style="margin-top: 5px;">+</button>
        </div>
    </div>

    <!-- Chat Area -->
    <div style="flex-grow: 1; background-color: #36393F; color: white; padding: 20px;">
        @if (SelectedChannel != null)
        {
            <h3># @SelectedChannel.ChannelName</h3>

            <div class="messages-container" style="max-height: calc(100vh - 150px); overflow-y: auto;">
                @if (!Messages.Any())
                {
                    <p>No messages yet...</p>
                }
                else
                {
                    @foreach (var msg in Messages)
                    {
                        <div class="message">
                            <strong>@msg.Username:</strong> @msg.Message
                        </div>
                    }
                }
            </div>

            <div style="margin-top: 10px;">
                <input @bind="newMessage" placeholder="Type your message..." @onkeydown="HandleKeyPress" style="width: 80%;" />
                <button @onclick="SendMessage">Send</button>
            </div>
        }
        else
        {
            <p>Select a channel to start chatting</p>
        }
    </div>
</div>

@code {
    [Parameter] public int CurrentUserId { get; set; }
    [Parameter] public int ServerId { get; set; }

    private List<Channel> Channels;
    private Channel SelectedChannel;
    private string NewChannelName;
    private List<ChatMessage> Messages = new();
    private string newMessage;

    private HubConnection hubConnection;

    protected override async Task OnInitializedAsync()
    {
        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/chathub"))
            .Build();

        hubConnection.On<ChatMessage>("ReceiveGroupMessage", (message) =>
        {
            if (SelectedChannel != null && message.ChannelId == SelectedChannel.Id.ToString())
            {
                Messages.Add(message);
                InvokeAsync(StateHasChanged);
            }
        });

        await hubConnection.StartAsync();
    }
    protected override async Task OnParametersSetAsync()
    {
        Channels = (await ChannelService.GetChannelsByServerIdAsync(ServerId)).ToList();
        SelectedChannel = null;
        Messages.Clear();
    }
    private async Task SelectChannel(Channel channel)
    {
        // Leave old group
        if (SelectedChannel != null)
        {
            await hubConnection.SendAsync("RemoveFromGroup", SelectedChannel.Id.ToString());
        }

        SelectedChannel = channel;
        Messages.Clear();

        // Join new group
        await hubConnection.SendAsync("AddToGroup", SelectedChannel.Id.ToString());
    }

    private async Task SendMessage()
    {
        if (!string.IsNullOrWhiteSpace(newMessage) && SelectedChannel != null)
        {
            var user = await UserService.GetByIdAsync(CurrentUserId);
            var message = new ChatMessage
            {
                Username = user.Name,
                Message = newMessage,
                ChannelId = SelectedChannel.Id.ToString()
            };

            await hubConnection.SendAsync("SendMessageToGroup", SelectedChannel.Id.ToString(), message);

            newMessage = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessage();
        }
    }

    private async Task AddChannelAsync()
    {
        if (!string.IsNullOrWhiteSpace(NewChannelName))
        {
            var channel = await ChannelService.AddNewChannel(NewChannelName, ServerId);
            Channels.Add(channel);
            NewChannelName = string.Empty;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
