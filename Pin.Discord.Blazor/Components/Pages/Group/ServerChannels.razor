@page "/user/{CurrentUserId:int}/servers/{ServerId:int}"

@using Pin.Discord.Core.Entities
@using Pin.Discord.Core.Interfaces
@using Microsoft.AspNetCore.SignalR.Client
@using Pin.Discord.Blazor.Models
@using Pin.Discord.Blazor.State

@inject IServerMemberService ServerMemberService
@inject IServerService ServerService
@inject IChannelService ChannelService
@inject IUserService UserService
@inject IMessageService MessageService
@inject NavigationManager Navigation
@inject UserState UserState
@inject ServerState ServerState

<div style="display: flex; height: 100vh;">
    <!-- Channel Sidebar -->
    <div style="width: 240px; background-color: #2F3136; color: white; display: flex; flex-direction: column;">
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px;">
            <h4 style="margin: 0;">channels</h4>
            <!-- Three dot menu -->
            <div style="position: relative;">
                <button class="btn btn-sm btn-secondary" @onclick="ToggleMenu">
                    ⋮
                </button>

                @if (isMenuOpen)
                {
                    <ul class="dropdown-menu show" style="display:block; position:absolute; right:0; top:100%;">
                        <li>
                            <a class="dropdown-item" href="#" @onclick="ShowRenameInput"@onclick:preventDefault="true">Rename Server</a>
                        </li>
                        <li>
                            <a class="dropdown-item text-danger" href="#" @onclick="LeaveServer">Leave Server</a>
                        </li>
                    </ul>

                }
            </div>
        </div>
            @if (showRenameInput)
            {
                <div style="padding:10px;">
                    <input @bind="newServerName" placeholder="New server name" style="width: 100%;" />
                    <button class="btn btn-sm btn-primary" @onclick="RenameServer">Save</button>
                    <button class="btn btn-sm btn-secondary" @onclick="CancelRename">Cancel</button>
                </div>
            }
        <!-- channels List -->
        @if (channels == null)
        {
            <p style="padding: 10px;">Loading...</p>
        }
        else
        {
            @foreach (var channel in channels)
            {
                <div @onclick="() => SelectChannel(channel)"
                     style="padding: 8px 12px; cursor: pointer; color: @(selectedChannel?.Id == channel.Id ? "white" : "#b9bbbe")">
                    # @channel.ChannelName
                </div>
            }
        }

        <!-- Add Channel -->
        <div style="padding: 10px;">
            <input @bind="newChannelName" placeholder="New channel name" style="width: 100%;" />
            <button @onclick="AddChannelAsync" style="margin-top: 5px;">+</button>
        </div>
    </div>

    <!-- Chat Area -->
    <div style="flex-grow: 1; background-color: #36393F; color: white; padding: 20px;">
        @if (selectedChannel != null)
        {
            <h3># @selectedChannel.ChannelName</h3>

            <div class="messages-container" style="max-height: calc(100vh - 150px); overflow-y: auto;">
                @if (!messages.Any())
                {
                    <p>No messages yet...</p>
                }
                else
                {
                    @foreach (var msg in messages)
                    {
                        <div class="message-container" style="position: relative; margin-bottom: 12px; padding: 10px 12px; background-color: #40444B; border-radius: 8px; max-width: 70%;">
                            <strong>@msg.Username:</strong> @msg.Message

                        <div class="reactions" style="position: absolute; top: 4px; right: 4px; display: flex; gap: 4px; align-items: center;">
                            @foreach (var reaction in msg.Reactions)
                            {
                                <span style="background-color:#5865F2; color:white; padding:2px 6px; border-radius:12px; font-size:0.8em;">
                                    @reaction.Key (@reaction.Value.Count)
                                </span>
                            }
                            <button @onclick='() => AddReaction(msg, " 👍")'>👍</button>
                            <button @onclick='() => AddReaction(msg, " ❤️")'>❤️</button>
                            @if (msg.SenderId != CurrentUserId)
                            {
                                @if (!msg.IsReported)
                                {
                                    <button @onclick="() => ReportMessage(msg)"
                                            style="font-size:0.7em; background:none; border:none; cursor:pointer; color:#FF5555;">
                                        Report
                                    </button>
                                }
                                else
                                {
                                    <span style="font-size:0.7em; color:red;">Reported</span>
                                }
                            }
                        </div>
                        </div>
                    }
                }
            </div>
            <div style="margin-top: 10px;">
                <input @bind="newMessage" placeholder="Type your message..."
                       style="flex: 1; padding: 8px; border-radius: 4px; border: none;" />
                <button @onclick="SendMessage">Send</button>
            </div>
        }
        else
        {
            <p>Select a channel to start chatting</p>
        }
    </div>
</div>

@code {
    [Parameter] public int CurrentUserId { get; set; }
    [Parameter] public int ServerId { get; set; }

    private List<Channel> channels;
    private Channel selectedChannel;
    private string newChannelName;
    private List<ChatMessage> messages = new();
    private string newMessage;
    private string newServerName;
    private bool showRenameInput = false;
    private bool isMenuOpen;
    private HubConnection hubConnection;

    protected override async Task OnInitializedAsync()
    {
        if (!UserState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }
        hubConnection = new HubConnectionBuilder()
        .WithUrl(Navigation.ToAbsoluteUri("/chathub"))
        .Build();

        hubConnection.On<ChatMessage>("ReceiveGroupMessage", (message) =>
        {
            if (selectedChannel != null && message.ChannelId == selectedChannel.Id.ToString())
            {
                messages.Add(new ChatMessage
                {
                    Id = message.Id,
                    SenderId = message.SenderId,
                    Username = message.Username,
                    Message = message.Message,
                    ChannelId = message.ChannelId
                });
                InvokeAsync(StateHasChanged);
            }
        });
        hubConnection.On<Guid, int, string>("ReceiveGroupReaction", (messageId, userId, emoji) =>
        {
            var msg = messages.FirstOrDefault(m => m.Id == messageId);
            if (msg != null)
            {
                if (!msg.Reactions.ContainsKey(emoji))
                    msg.Reactions[emoji] = new List<int>();

                if (!msg.Reactions[emoji].Contains(userId))
                    msg.Reactions[emoji].Add(userId);

                InvokeAsync(StateHasChanged);
            }
        });

        await hubConnection.StartAsync();
    }
    protected override async Task OnParametersSetAsync()
    {
        channels = (await ChannelService.GetChannelsByServerIdAsync(ServerId)).ToList();
        selectedChannel = null;
        messages.Clear();
    }
    private async Task SelectChannel(Channel channel)
    {
        if (selectedChannel != null)
        {
            await hubConnection.SendAsync("RemoveFromGroup", selectedChannel.Id.ToString());
        }

        selectedChannel = channel;
        messages.Clear();

        await hubConnection.SendAsync("AddToGroup", selectedChannel.Id.ToString());
    }

    private async Task SendMessage()
    {
        if (!string.IsNullOrWhiteSpace(newMessage) && selectedChannel != null)
        {
            var user = await UserService.GetByIdAsync(CurrentUserId);
            var message = new ChatMessage
            {
                Id = Guid.NewGuid(),
                SenderId = user.Id,
                Username = user.Name,
                Message = newMessage,
                ChannelId = selectedChannel.Id.ToString()
            };

            await hubConnection.SendAsync("SendMessageToGroup", selectedChannel.Id.ToString(), message);

            newMessage = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
    }
    private async Task AddChannelAsync()
    {
        if (!string.IsNullOrWhiteSpace(newChannelName))
        {
            var channel = await ChannelService.AddNewChannel(newChannelName, ServerId);
            channels.Add(channel);
            newChannelName = string.Empty;
        }
    }
    private async Task LeaveServer()
    {
        try
        {
            await ServerMemberService.DeleteServerMemberAsync(ServerId, CurrentUserId);
            ServerState.Servers = (await ServerService.GetServersForUserAsync(CurrentUserId)).ToList();
            Navigation.NavigateTo($"/");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }
    private void ShowRenameInput()
    {
        showRenameInput = true;
        isMenuOpen = false;
    }
    private async Task RenameServer()
    {
        if (!string.IsNullOrWhiteSpace(newServerName))
        {
            try
            {
                await ServerService.EditServerNameAsync(ServerId, newServerName);
                ServerState.Servers = (await ServerService.GetServersForUserAsync(CurrentUserId)).ToList();
                newServerName = string.Empty;
                showRenameInput = false;
            }
            catch (Exception ex)
            {
                Console.WriteLine(ex.Message);
            }
        }
    }
    private void CancelRename()
    {
        newServerName = string.Empty;
        showRenameInput = false;
    }
    private void ToggleMenu()
    {
        isMenuOpen = !isMenuOpen;
    }
    private async Task AddReaction(ChatMessage msg, string emoji)
    {
        await hubConnection.SendAsync("AddReactionToGroup", msg.ChannelId, msg.Id, CurrentUserId, emoji);
    }
    private async Task ReportMessage(ChatMessage msg)
    {
        try
        {
            msg.IsReported = true;
            await MessageService.ReportMessageAsync(
                CurrentUserId,
                msg.SenderId,
                msg.Message,
                selectedChannel.Id
            );
            await InvokeAsync(StateHasChanged);

        }
        catch (Exception ex)
        {
            Console.WriteLine("Error reporting message: " + ex.Message);
        }
    }
    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
        {
            await hubConnection.DisposeAsync();
        }
    }

}
