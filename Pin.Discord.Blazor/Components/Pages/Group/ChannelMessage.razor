@*@page  ﻿"/user/{CurrentUserId:int}/servers/{ServerId:int}/channels{ChannelId:int}"

@using Pin.Discord.Core.Entities
@using Pin.Discord.Core.Interfaces
@using Microsoft.AspNetCore.SignalR.Client
@using Pin.Discord.Blazor.Models

@inject IChannelService ChannelService
@inject IUserService UserService
@inject NavigationManager Navigation

<h3>@CurrentChannel?.ChannelName</h3>

<div class="messages-container">
    @if (Messages == null)
    {
        <p>Start converstation</p>
    }
    else
    {
        @foreach (var msg in Messages)
        {
            <div class="message">
                <strong>@msg.Username:</strong> @msg.Message
            </div>
        }
    }
</div>


    <input @bind="newMessage" placeholder="Type your message..." @onkeydown="HandleKeyPress" />
    <button @onclick="SendMessage">Send</button>

@code {
    [Parameter]
    public int CurrentUserId { get; set; }
    [Parameter]
    public int ServerId { get; set; }
    [Parameter]
    public int ChannelId { get; set; }
    private Channel CurrentChannel;
    private List<ChatMessage> Messages = new();
    private string newMessage;
    private bool IsAuthenticated;
    private HubConnection hubConnection;

    protected override async Task OnInitializedAsync()
    {
        CurrentChannel = await ChannelService.GetChannelByChannelId(ChannelId);

        hubConnection = new HubConnectionBuilder()
        .WithUrl(Navigation.ToAbsoluteUri("/chathub"))
        .Build();

        hubConnection.On<ChatMessage>("ReceiveGroupMessage", (message) =>
        {

            Messages.Add(message);
            InvokeAsync(StateHasChanged);

        });

        await hubConnection.StartAsync();
        await hubConnection.SendAsync("AddToGroup", ChannelId.ToString());

    }
    private async Task SendMessage()
    {
        await hubConnection.SendAsync("AddToGroup", ChannelId.ToString());

        if (!string.IsNullOrWhiteSpace(newMessage))
        {
            var user = await UserService.GetByIdAsync(CurrentUserId);
            var message = new ChatMessage
            {
                Username = user.Name,
                Message = newMessage,
                ChannelId = ChannelId.ToString()
            };

            try
            {
                await hubConnection.SendAsync("SendMessageToGroup", ChannelId.ToString(), message);
            }
            catch (Exception ex)
            {
                Console.WriteLine("SendAsync failed: " + ex.Message);
            }
            newMessage = string.Empty;
            InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessage();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}*@
